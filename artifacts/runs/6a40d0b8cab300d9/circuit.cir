BoundaryLab generic nonideal opamp / bl-opamp-1.1
.options reltol=1e-5 abstol=1e-12 vntol=1e-7
Vin in 0 SIN(0 0.00214203821753 5547.80913979)
Bgm 0 dom I=max(-0.02, min(0.02, 0.00188495559215*(v(in)-v(fb))))
Rdom dom 0 53051647.6973
Cdom dom 0 1e-09 IC=0
Baw dom 0 I=0.01*(max(0,v(dom)-8)+min(0,v(dom)+8))
Brail drive 0 V=max(-8, min(8, v(dom)))
Rout drive out 30
Rload out 0 10000
Cload out 0 10p
Rf out fb 9000
Rg fb 0 1000
.control
set noaskquit
set wr_vecnames
set wr_singlescale
tran 8.1932424691e-07 0.00252351868048 0 8.1932424691e-07
wrdata samples.tsv v(in) v(out) v(dom)
quit
.endc
.end
