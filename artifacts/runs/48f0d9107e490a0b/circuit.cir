BoundaryLab generic nonideal opamp / bl-opamp-1.1
.options reltol=1e-5 abstol=1e-12 vntol=1e-7
Vin in 0 SIN(0 0.00588566191277 23403.4731932)
Bgm 0 dom I=max(-0.0005, min(0.0005, 0.00942477796077*(v(in)-v(fb))))
Rdom dom 0 10610329.5395
Cdom dom 0 1e-09 IC=0
Baw dom 0 I=0.01*(max(0,v(dom)-4)+min(0,v(dom)+4))
Brail drive 0 V=max(-4, min(4, v(dom)))
Rout drive out 30
Rload out 0 10000
Cload out 0 10p
Rf out fb 39000
Rg fb 0 1000
.control
set noaskquit
set wr_vecnames
set wr_singlescale
tran 1.94221366544e-07 0.000598201808955 0 1.94221366544e-07
wrdata samples.tsv v(in) v(out) v(dom)
quit
.endc
.end
