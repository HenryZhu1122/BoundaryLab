BoundaryLab generic nonideal opamp / bl-opamp-1.1
.options reltol=1e-5 abstol=1e-12 vntol=1e-7
Vin in 0 SIN(0 0.00688776232998 109.594532518)
Bgm 0 dom I=max(-0.008, min(0.008, 0.0502654824574*(v(in)-v(fb))))
Rdom dom 0 1989436.78865
Cdom dom 0 1e-09 IC=0
Baw dom 0 I=0.01*(max(0,v(dom)-4)+min(0,v(dom)+4))
Brail drive 0 V=max(-4, min(4, v(dom)))
Rout drive out 30
Rload out 0 10000
Cload out 0 10p
Rf out fb 9000
Rg fb 0 1000
.control
set noaskquit
set wr_vecnames
set wr_singlescale
tran 4.14751944375e-05 0.127743598868 0 4.14751944375e-05
wrdata samples.tsv v(in) v(out) v(dom)
quit
.endc
.end
