BoundaryLab generic nonideal opamp / bl-opamp-1.1
.options reltol=1e-5 abstol=1e-12 vntol=1e-7
Vin source 0 SIN(0 0.0144415388094 273.700726136)
Bgm 0 dom I=max(-0.02, min(0.02, 0.125663706144*(v(in)-v(fb))))
Rdom dom 0 795774.715459
Cdom dom 0 1e-09 IC=0
Baw dom 0 I=0.01*(max(0,v(dom)-4)+min(0,v(dom)+4))
Brail drive 0 V=max(-4, min(4, v(dom)))
Rout drive out 30
Rload out 0 10000
Cload out 0 10p
Rf out fb 1000
Rg fb 0 1000
Rfilter source in 1000
Cfilter in 0 7.95774715459e-08
.control
set noaskquit
set wr_vecnames
set wr_singlescale
tran 1.66073894272e-05 0.0511507594359 0 1.66073894272e-05
wrdata samples.tsv v(source) v(out) v(dom)
quit
.endc
.end
