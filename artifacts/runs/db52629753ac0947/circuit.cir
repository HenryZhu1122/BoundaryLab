BoundaryLab generic nonideal opamp / bl-opamp-1.1
.options reltol=1e-5 abstol=1e-12 vntol=1e-7
Vin in 0 SIN(0 0.0433713806911 2127.97623969)
Bgm 0 dom I=max(-0.0001, min(0.0001, 0.251327412287*(v(in)-v(fb))))
Rdom dom 0 397887.35773
Cdom dom 0 1e-09 IC=0
Baw dom 0 I=0.01*(max(0,v(dom)-12)+min(0,v(dom)+12))
Brail drive 0 V=max(-12, min(12, v(dom)))
Rout drive out 30
Rload out 0 10000
Cload out 0 10p
Rf out fb 9000
Rg fb 0 1000
.control
set noaskquit
set wr_vecnames
set wr_singlescale
tran 2.13604572301e-06 0.00657902082688 0 2.13604572301e-06
wrdata samples.tsv v(in) v(out) v(dom)
quit
.endc
.end
