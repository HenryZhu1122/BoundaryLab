BoundaryLab generic nonideal opamp / bl-opamp-1.1
.options reltol=1e-5 abstol=1e-12 vntol=1e-7
Vin in 0 SIN(0 0.420282125654 590.246645623)
Bgm 0 dom I=max(-0.02, min(0.02, 0.125663706144*(v(in)-v(fb))))
Rdom dom 0 795774.715459
Cdom dom 0 1e-09 IC=0
Baw dom 0 I=0.01*(max(0,v(dom)-2)+min(0,v(dom)+2))
Brail drive 0 V=max(-2, min(2, v(dom)))
Rout drive out 30
Rload out 0 10000
Cload out 0 10p
Rf out fb 9000
Rg fb 0 1000
.control
set noaskquit
set wr_vecnames
set wr_singlescale
tran 7.70094091879e-06 0.0237188980299 0 7.70094091879e-06
wrdata samples.tsv v(in) v(out) v(dom)
quit
.endc
.end
